# OpenRouter API Key for LLM inference (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Serper API Key for Google search (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter Model ID (default: google/gemini-2.5-flash or openai/gpt-4o-mini or deepseek/deepseek-chat)
OPENROUTER_MODEL=openai/gpt-4o-mini

# WhatsApp Web Automation Settings
# Path to store persistent Chrome profile (keeps WhatsApp logged in)
CHROME_PROFILE_DIR=./.wweb_profile

# Set to false for first run so you can scan QR code. Set to true once logged in if headless is desired.
HEADLESS_BROWSER=false

# Polling interval in seconds to check for new messages
POLL_INTERVAL_SECONDS=3

# Output directory for generated notes documents (PDF, DOCX, PPTX)
OUTPUT_DIR=./generated_notes

# STRICT PRIVACY GUARD: Comma-separated list of allowed chat/contact names.
# The agent will NEVER touch, open, or reply to any other chat or group.
# WhatsApp self-chat titles are typically "You", "Message yourself", or "(You)".
# You can also add specific contact names like: "You,Talha,+91XXXXXXXXXX"
ALLOWED_CHATS=You,Message yourself,(You)
